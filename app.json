{
  "expo": {
    "name": "Sotto",
    "slug": "sotto-app",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sotto",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Sotto a biometrikus zároláshoz használja.",
        "NSCameraUsageDescription": "Fotó és videó készítéséhez.",
        "NSMicrophoneUsageDescription": "Videófelvételhez.",
        "NSPhotoLibraryUsageDescription": "Kép küldéséhez."
      },
      "bundleIdentifier": "com.sotto.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS"
      ],
      "package": "com.sotto.app",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Fotó és videó készítéséhez.",
          "microphonePermission": "Videófelvételhez.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4A4FD8"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Biometrikus zároláshoz."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128,
          "dark": {
            "backgroundColor": "#0E1015"
          }
        }
      ],
      "./plugins/withReleaseSigning.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://api.sotto.commandos.rozsnorbert.hu"
    }
  }
}
